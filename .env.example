# Environment variables for the leaderboard API (api/scores.js).
# Copy to .env.local for local `vercel dev`, and add the same keys in
# Vercel -> frostbyte-anniversary-game -> Settings -> Environment Variables
# (Production + Preview). Never commit a real .env file.

# Required. Supabase -> Project Settings -> API Keys -> Secret keys (sb_secret_...),
# or the legacy service_role key. NOT the publishable (sb_publishable_...) or anon key.
# Server-side only: it bypasses row level security, so it must never reach the browser.
# (SUPABASE_SERVICE_ROLE_KEY is accepted as an older name for the same thing.)
SUPABASE_SECRET_KEY=

# Optional. Defaults to this project's Supabase URL.
SUPABASE_URL=https://dkgwmqujhxwnzrnxiswm.supabase.co

# Optional. Salt for hashing player IPs (used only for rate limiting).
# Defaults to the secret key; set any long random string to keep hashes stable if the key rotates.
IP_SALT=

# Not used by the game (the API talks to Supabase with the secret key above, not the
# Postgres password). Only needed if you connect to the database directly with a SQL client.
DB_PASSWORD=
